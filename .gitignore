# Downloaded data — regenerate it by running the pipeline, do not commit it.
# Committing large data files is the fastest way to make a repo unusable.
data/raw/
*.tif
*.png
# Un-ignore images that are part of the published site. The original rule was
# "!docs/*.png", which only reaches files sitting DIRECTLY in docs/ — a single
# asterisk does not cross a directory separator. docs/site/preview.png stayed
# ignored, git add skipped it without a word, and the published page 404'd on
# its own preview image. Two asterisks cross directories.
!docs/**/*.png

# Outputs are generated by running the pipeline — do not commit them.
# When you have a REAL-data map you are happy with, copy it to docs/site/index.html
# and commit that one file so GitHub Pages can serve it. Never commit a --demo map:
# it is synthetic and would be mistaken for a result.
outputs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Editors
.vscode/
.idea/
.DS_Store
