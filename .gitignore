# Downloaded data — regenerate it by running the pipeline, do not commit it.
# Committing large data files is the fastest way to make a repo unusable.
data/raw/
*.tif
*.png
!docs/*.png

# Outputs are generated by running the pipeline — do not commit them.
# When you have a REAL-data map you are happy with, copy it to docs/site/index.html
# and commit that one file so GitHub Pages can serve it. Never commit a --demo map:
# it is synthetic and would be mistaken for a result.
outputs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Editors
.vscode/
.idea/
.DS_Store
